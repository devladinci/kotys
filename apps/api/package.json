{
  "name": "@kotys/api",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild dist/main.js --bundle --platform=node --format=cjs --outfile=dist/main.bundle.cjs --external:better-sqlite3 --log-level=warning",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@kotys/contracts": "workspace:*",
    "@kotys/db": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@orpc/server": "^1.15.4",
    "@saystack/core": "^0.2.1",
    "@saystack/engine-openai-compatible": "^0.1.4",
    "@saystack/server": "^0.1.3",
    "hono": "^4.13.13",
    "ollama": "^0.6.4",
    "typescript-language-server": "^6.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
